# Server only. Never expose these through VITE_* variables.
ENVIRONMENT=development
# local is explicit offline development; use supabase for manual integration/production.
AUTH_MODE=local
BACKEND_PORT=8001
FRONTEND_PORT=3000
PROJECT_NAME="Simplifier 2.0"
MAX_FILE_SIZE_MB=15
# Required for production; publishable/anon key only, NEVER service_role.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Explicit HTTPS frontend origin(s), comma separated. Prefer same-origin API proxy.
# CORS_ORIGINS=https://your-frontend.example
# OSM discovery: no keys/billing. Public services: ONE replica only; shared private
# writable APP_DATA_DIR must persist cache/aggregate limits. See docs/OSM_DISCOVERY.md.
# Controls nationwide LIVE requests only; Mumbai snapshot works even when false.
OSM_DISCOVERY_ENABLED=true
OSM_USER_AGENT="Simplifier2.0/1.0 (+https://github.com/Shoaibbb-C0/Simplifier2.0)"
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Local development storage; production uses Supabase with the patient JWT and RLS.
# APP_DATA_DIR=/absolute/path/private-data
